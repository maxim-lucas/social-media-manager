# Meta (Facebook/Instagram) API credentials
# Get these from https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=

# Facebook Page to post to (POST /api/publish), and a Page access token with
# pages_manage_posts. The same token is reused for Instagram unless
# META_INSTAGRAM_ACCESS_TOKEN is set separately.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

# Instagram professional account linked to the same Page (instagram_content_publish).
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
# META_INSTAGRAM_ACCESS_TOKEN=
